# ==============================================================================
# Oskolok Production Environment Configuration
# Copy to .env and fill in your actual production values.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# Database (file:./dev.db for local SQLite, or PostgreSQL connection string)
DATABASE_URL=file:./dev.db

# CORS Allowed Origin (e.g. https://your-domain.com)
CORS_ORIGIN=https://your-domain.com

# Frontend API URL (leave /api for relative same-domain reverse proxy)
VITE_API_URL=/api

# Optional Music Providers (SoundCloud & Spotify fallback / scrapers work out of the box)
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional Paths for Python & ffmpeg (auto-detected from system PATH if installed)
# PYTHON_PATH=/usr/bin/python3
# FFMPEG_PATH=/usr/bin/ffmpeg

# Telegram Mini App (local desktop remains the default)
# Set TELEGRAM_MODE=true on the public Telegram server to require signed identity.
TELEGRAM_MODE=false
GENIUS_ACCESS_TOKEN=
# Secret key from https://developers.spicylyrics.org/dashboard (server only).
SPICY_LYRICS_SECRET_KEY=
# Optional Oskolok/community lyrics service (JSON/LyricsData response)
LYRICS_PROVIDER_URL=
TELEGRAM_BOT_USERNAME=oskolokplayerbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Private encryption key is generated here on first login. Keep this directory private and backed up.
OSKOLOK_PRIVATE_DIR=server/data/private

# Registered OAuth redirect: <origin>/api/music-accounts/spotify/callback (and soundcloud/callback)
MUSIC_OAUTH_ORIGIN=http://127.0.0.1:5000
