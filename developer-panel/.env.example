PORT=4100
# Public URL of this panel; used for same-origin mutation checks.
PANEL_ORIGIN=http://localhost:4100
# URL reachable by the panel server (never an arbitrary browser-supplied URL).
OSKOLOK_API_URL=http://127.0.0.1:5000/api
# Must match ADMIN_API_KEY in the player's server environment. At least 32 chars.
ADMIN_API_KEY=
# Separate password for signing into the panel. At least 16 chars.
PANEL_PASSWORD=
